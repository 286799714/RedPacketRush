{
  "private": true,
  "name": "red-packet-rush-server",
  "version": "0.1.0",
  "description": "Authoritative Colyseus server for the Red Packet Rush four-participant card-game prototype",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "loadtest": "tsx loadtest/example.ts --room game --numClients 2",
    "schema:generate": "schema-codegen src/rooms/schema/GameRoomState.ts --gdscript --bundle --output ../client/schema/",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "test": "mocha -r tsx test/**.test.ts --exit --timeout 15000"
  },
  "author": "Red Packet Rush",
  "license": "UNLICENSED",
  "devDependencies": {
    "@colyseus/loadtest": "^0.17.7",
    "@colyseus/sdk": "^0.17.17",
    "@colyseus/testing": "^0.17.10",
    "@types/express": "^4.17.1",
    "@types/mocha": "^10.0.1",
    "mocha": "^11.7.5",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@colyseus/core": "0.17.50",
    "@colyseus/schema": "^4.0.0",
    "@colyseus/tools": "^0.17.0",
    "colyseus": "^0.17.6",
    "express": "^4.18.2"
  }
}
