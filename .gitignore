# Godot editor and .NET build output
client/.godot/
client/.mono/
client/bin/
client/obj/

# The prototype ships Windows x86_64 and Android arm64 Colyseus binaries.
client/addons/colyseus/bin/*
!client/addons/colyseus/bin/colyseus_godot.windows.x86_64.debug.dll
!client/addons/colyseus/bin/colyseus_godot.windows.x86_64.release.dll
!client/addons/colyseus/bin/libcolyseus_godot.android.arm64.debug.so
!client/addons/colyseus/bin/libcolyseus_godot.android.arm64.release.so

# Local export artifacts
/build/
*.apk
*.aab

# Signing keys and certificate material
*.keystore
*.jks
*.p12
*.pfx
*.pem

# Local editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Runtime logs
*.log

# Regenerable visual QA captures
.scratch/*-visuals/

# Local environment files may contain credentials.
**/.env*
!**/.env.example
!**/.env.*.example
